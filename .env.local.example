# Kosongkan IMAGE_API_KEY untuk mode demo (gambar tiruan, tanpa biaya).
IMAGE_API_URL=https://api.sekaigateway.xyz/v1/images/generations
IMAGE_API_KEY=
IMAGE_MODEL=pixel/gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=low
# Kosongkan untuk menonaktifkan kode akses (hanya untuk lokal).
ACCESS_CODE=
# Chat teks. Kosongkan CHAT_MODEL untuk mode demo.
# CHAT_API_URL default: IMAGE_API_URL dengan /images/generations diganti /chat/completions
CHAT_API_URL=
CHAT_MODEL=
# Opsional, default memakai IMAGE_API_KEY
CHAT_API_KEY=
